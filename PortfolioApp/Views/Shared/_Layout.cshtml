@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] — Harvey Ischei Pelarca / Portfolio</title>
    <meta name="description" content="A curated digital archive of 17 ASP.NET Core MVC projects built by Harvey Ischei Pelarca." />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <header class="site-header">
        <div class="container nav">
            <a class="nav-brand" href="/">
                <span class="dot"></span>
                PELARCA.DEV
            </a>

            <button class="nav-toggle" aria-label="Toggle navigation" aria-expanded="false">
                <span></span>
            </button>

            <ul class="nav-links">
                <li><a href="/" class="@(currentController == "Home" ? "active" : "")">Portfolio</a></li>
                <li><a asp-controller="Projects" asp-action="Index" class="@(currentController == "Projects" ? "active" : "")">Project Index</a></li>
                <li><a asp-controller="Home" asp-action="About" class="@(ViewContext.RouteData.Values["action"]?.ToString() == "About" ? "active" : "")">About</a></li>
                @if (User.Identity != null && User.Identity.IsAuthenticated)
                {
                    <li><a asp-controller="Account" asp-action="Dashboard">Dashboard</a></li>
                    <li>
                        <form asp-controller="Account" asp-action="Logout" method="post" style="display:inline;">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-ghost" style="font-family:inherit;">Logout</button>
                        </form>
                    </li>
                }
                else
                {
                    <li><a asp-controller="Account" asp-action="Login" class="@(currentController == "Account" ? "active" : "")">Login</a></li>
                }
            </ul>
        </div>
    </header>

    <main>
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container footer-row">
            <div>
                <div class="footer-brand">HARVEY ISCHEI PELARCA</div>
                <div class="footer-sub">ASP.NET Core MVC Portfolio — Digital Project Archive</div>
            </div>
            <div class="footer-links">
                <a href="https://github.com/ishpo29" target="_blank" rel="noopener noreferrer">GitHub ↗</a>
                <a asp-controller="Projects" asp-action="Index">Project Index</a>
                <span class="mono">© 2026</span>
            </div>
        </div>
    </footer>

    <script src="~/js/site.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
