@{
    ViewData["Title"] = "About";
}

<section class="page-header">
    <div class="container">
        <span class="eyebrow">ABOUT / THE ARCHIVE</span>
        <h1>A record of learning<br />the .NET MVC stack.</h1>
        <p>
            This portfolio documents 17 ASP.NET Core MVC repositories produced over the
            Prelim, Midterm and Prefinal terms of the IT Elective 2 course (BSIT31E3),
            authored by Harvey Ischei Pelarca. Rather than a single polished application,
            it is intentionally structured as an archive — each entry a real, dated
            checkpoint in a development journey, complete with its own repository,
            description and discussion thread.
        </p>
    </div>
</section>

<section class="list-section">
    <div class="container">
        <div class="detail-body" style="grid-template-columns: 1fr 1fr;">
            <div>
                <div class="block-title">Approach</div>
                <p class="block-text">
                    Every project listed here links to its exact GitHub repository —
                    no placeholder links, no invented functionality. Descriptions are
                    written from the repository's name, context and course phase, and
                    the site is honest about which thumbnails are generated abstractions
                    rather than real application screenshots.
                </p>
            </div>
            <div>
                <div class="block-title">Stack</div>
                <p class="block-text">
                    The portfolio itself is built with ASP.NET Core MVC — C#, Razor views,
                    strongly-typed view models, server-side validation, and cookie-based
                    authentication for the restricted administration area.
                </p>
            </div>
        </div>
    </div>
</section>
