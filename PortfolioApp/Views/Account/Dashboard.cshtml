@{
    ViewData["Title"] = "Dashboard";
}

<section class="page-header">
    <div class="container">
        <span class="eyebrow">RESTRICTED / ADMINISTRATION</span>
        <h1>Portfolio Dashboard</h1>
        <p>Signed in as <span class="mono">@User.Identity?.Name</span>. This area is only reachable while authenticated.</p>
    </div>
</section>

<section class="list-section">
    <div class="container">
        <div class="dashboard-grid">
            <div class="dashboard-tile">
                <div class="value">@ViewBag.TotalProjects</div>
                <div class="label">Total Projects</div>
            </div>
            <div class="dashboard-tile">
                <div class="value">@ViewBag.TotalComments</div>
                <div class="label">Total Comments</div>
            </div>
            <div class="dashboard-tile">
                <div class="value">17/17</div>
                <div class="label">Repositories Linked</div>
            </div>
        </div>

        <div style="margin-top:40px;">
            <a class="btn btn-ghost" asp-controller="Projects" asp-action="Index">View Project Index</a>
        </div>
    </div>
</section>
